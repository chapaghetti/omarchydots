
# Application bindings

$terminal = uwsm-app -- xdg-terminal-exec
$browser = zen-browser
$olwa = omarchy-launch-webapp

# $browser = omarchy-launch-browser
# If your web app url contains #, type it as ## to prevent hyprland treating it as a comment

# bindd = SUPER SHIFT, B, Browser, exec, $browser
# bindd = SUPER SHIFT, D, Docker, exec, omarchy-launch-tui lazydocker
# bindd = SUPER SHIFT, W, Typora, exec, uwsm-app -- typora

bindd = SUPER, RETURN, Terminal, exec, uwsm-app -- xdg-terminal-exec --dir="$(omarchy-cmd-terminal-cwd)"
bindd = SUPER ALT, RETURN, Tmux, exec, uwsm-app -- xdg-terminal-exec --dir="$(omarchy-cmd-terminal-cwd)" bash -c "tmux attach || tmux new -s Work"
bindd = SUPER CTRL, RETURN, Terminal, exec, $terminal bash -c "cliamp" & $terminal bash -c "cbonsai -il" & $terminal bash -c "rmatrix -r" & $terminal bash -c "btop"  

bindd = SUPER SHIFT, A, ChatGPT, exec, omarchy-launch-webapp "https://chatgpt.com"
bindd = SUPER SHIFT, B, Passwords, exec, bitwarden-desktop
bindd = SUPER SHIFT, C, Calendar, exec, omarchy-launch-webapp "https://app.hey.com/calendar/weeks/"
bindd = SUPER SHIFT, D, Discord, exec, omarchy-launch-webapp "https://discord.com/app"
bindd = SUPER SHIFT, E, Email, exec, omarchy-launch-webapp "https://protonmail.com"
bindd = SUPER SHIFT, F, File manager, exec, uwsm-app -- nautilus --new-window
bindd = SUPER SHIFT, G, Signal, exec, omarchy-launch-or-focus signal "uwsm-app -- signal-desktop"
bindd = SUPER SHIFT, H, OpenHue, exec, omarchy-launch-or-focus-tui ~/bin/hue-tui.sh
bindd = SUPER SHIFT, J, Joplin, exec, Joplin
bindd = SUPER SHIFT, L, LocalSend, exec, localsend
bindd = SUPER SHIFT, M, Music, exec, omarchy-launch-or-focus spotify
bindd = SUPER SHIFT, N, Editor, exec, omarchy-launch-editor
bindd = SUPER SHIFT, O, OBS, exec, obs
bindd = SUPER SHIFT, P, Plastic SCM, exec, linplasticx 
bindd = SUPER SHIFT, R, Remmina, exec, remmina
bindd = SUPER SHIFT, S, Steam, exec, steam
bindd = SUPER SHIFT, T, Activity, exec, omarchy-launch-tui btop
bindd = SUPER SHIFT, U, Unity Hub, exec, unityhub 
bindd = SUPER SHIFT, W, TheWizard, exec, /home/nugget/Documents/Unity/DevBuilds/2025_10_29/TheWizard.x86_64 -screen-fullscreen 0 -monitor 1 
bindd = SUPER SHIFT, X, X, exec, omarchy-launch-webapp "https://x.com/"
bindd = SUPER SHIFT, Y, YouTube, exec, omarchy-launch-webapp "https://youtube.com/"
bindd = SUPER SHIFT, Z, Zen, exec, $browser 
bindd = SUPER SHIFT, RETURN, Web Browser, exec, chromium

bindd = SUPER SHIFT CTRL, A, Aseprite, exec, omarchy-launch-or-focus aseprite
bindd = SUPER SHIFT CTRL, T, Twitch, exec, omarchy-launch-webapp "https://twitch.tv"
bindd = SUPER SHIFT CTRL, Z, Zen, exec, $browser --private-window

bindd = SUPER SHIFT ALT, B, Browser (private), exec, $browser --private-window
bindd = SUPER SHIFT ALT, F, File manager (cwd), exec, uwsm-app -- nautilus --new-window "$(omarchy-cmd-terminal-cwd)"
bindd = SUPER SHIFT ALT, G, WhatsApp, exec, omarchy-launch-or-focus-webapp WhatsApp "https://web.whatsapp.com/"
bindd = SUPER SHIFT ALT, H, Hacker News, exec, firefox https://news.ycombinator.com

unbind = , PRINT
unbind = SHIFT, PRINT
unbind = CTRL, PRINT
unbind = ALT, PRINT
unbind = CTRL ALT, PRINT
unbind = SUPER, PRINT

bindd = SUPER, bracketleft, Screenshot of region, exec, omarchy-cmd-screenshot
bindd = SUPER SHIFT, bracketleft, Screenshot of window, exec, omarchy-capture-screenshot window
bindd = SUPER CTRL, bracketleft, Screenshot of display, exec, omarchy-capture-screenshot output
bindd = SUPER ALT, bracketleft, Screen record a region, exec, omarchy-capture-screenrecord
bindd = SUPER CTRL ALT, bracketleft, Screen record display, exec, omarchy-capture-screenrecording output

