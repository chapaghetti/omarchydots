{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "nugget.workspaces"
        },
        {
          "id": "nugget.indicators"
        }
      ],
      "left": [
        {
          "id": "nugget.menu"
        },
        {
          "id": "disk",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/disk-usage",
          "interval": 5,
          "tooltip": "Disk usage on /",
          "onClick": "omarchy-launch-or-focus-tui gdu /"
        },
        {
          "id": "mem",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/mem-usage",
          "interval": 5,
          "tooltip": "Memory utilization",
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "cpu",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/cpu-usage",
          "interval": 5,
          "tooltip": "CPU utilization",
          "onClick": "omarchy-launch-or-focus-tui btop"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "id": "nugget.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "nugget.power"
        },
        {
          "id": "omarchy.clock",
          "format": "h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    },
    "position": "top",
    "transparent": false,
    "id": "nugget.bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "nugget.menu"
  ]
}
